# All keys are optional — the service runs without any of them.

# Massive (ex-Polygon) — daily NYSE closes (basis) + US ticker catalog (coverage page).
# Without it, basis and the Coverage tab stay empty; everything else works.
MASSIVE_API_KEY=

# Codex.io — optional alternative to GeckoTerminal for on-chain AMM data (paid plan required).
CODEX_API_KEY=

# Where DuckDB + parquet snapshots live (default: service/data)
VM_DATA=./data

# Poll intervals, seconds (defaults shown)
#VM_POLL_INTERVAL_CEX=90
#VM_POLL_INTERVAL_DEX=60
#VM_DEPTH_INTERVAL=3600

# Comma-separated venue_ids to skip, e.g. "htx_fut,bitrue"
#VM_DISABLE_VENUES=
